
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://powercare-inverter-service-center.onrender.com/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://powercare-inverter-service-center.onrender.com/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
